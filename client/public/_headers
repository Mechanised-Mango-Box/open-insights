# Response headers for Cloudflare Pages. Copied to the build output root by the
# `public/**/*` assets glob in angular.json, where Pages parses it - it is never
# served as a file itself.
#
# This file is the reason the client is on Pages rather than GitHub Pages, which
# cannot send custom headers at all. See the note on cross-origin isolation at
# the bottom.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

  # Safe on its own. Cross-Origin-Embedder-Policy is deliberately NOT set
  # alongside it - see the bottom of this file.
  Cross-Origin-Opener-Policy: same-origin

  # index.html must not be cached: it names the hashed bundles, so a stale copy
  # points at files that no longer exist. The hashed assets themselves are
  # overridden below.
  Cache-Control: public, max-age=0, must-revalidate

  # REPORT-ONLY, deliberately, and it should stay that way until someone has
  # loaded the deployed site with devtools open and seen zero violations on both
  # paths: first load (fonts) and a Scan. Then delete "-Report-Only" from the
  # line below to start enforcing it.
  #
  # What each source is for:
  #   style 'unsafe-inline'
  #                       Angular Material writes inline styles, and index.html
  #                       carries inlined critical CSS.
  #   blob:               <video> playback from the File objects held in
  #                       IndexedDB, and the export download.
  #
  # connect-src also has to name your API server. Update it when SITE_ADDRESS
  # changes, or the browser blocks every call with the CSP as the only clue.
  #
  # localhost:5000 is listed because running your own server is an offered path
  # here, not just an operator's - the Overview card and the prompt on load both
  # point at it. A self-hoster on any other host or port has to add theirs, one
  # more reason this policy stays Report-Only until every path has been walked.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' blob: https://open-insights.duckdns.org http://localhost:5000 http://127.0.0.1:5000; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

# Content-hashed by the build (outputHashing: "all"), so the name changes
# whenever the bytes do and these can never go stale.
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# ---------------------------------------------------------------------------
# On cross-origin isolation
# ---------------------------------------------------------------------------
# Adding
#     Cross-Origin-Embedder-Policy: require-corp
# to the /* block above would make the page cross-origin isolated, which is what
# SharedArrayBuffer and multi-threaded WebAssembly need. Nothing here needs
# either: the server does the analysis, and this client only imports, charts and
# exports. It is left off because it is not free - under require-corp every
# cross-origin subresource needs CORP or CORS, which would break the Google
# Fonts <link>s in index.html.
