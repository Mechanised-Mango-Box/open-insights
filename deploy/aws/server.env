# The non-secret half of the AWS host's .env. bootstrap.sh copies this in and appends
# PUBLIC_API_KEY / PRIVATE_API_KEY from SSM. See .env.example for what each one means.
#
# If SITE_ADDRESS ever changes, client/src/app/data-management/server-config.service.ts
# (DEFAULT_SERVER_URL) and connect-src in client/public/_headers must change with it.
SITE_ADDRESS=open-insights.duckdns.org
ALLOWED_ORIGINS=https://open-insights-ccx.pages.dev
# On the data volume - see bootstrap.sh.
DATA_DIR=/opt/open-insights/persist/data
