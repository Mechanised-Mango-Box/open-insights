# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env

# The hostname Caddy gets a TLS certificate for. Point a free DuckDNS subdomain
# at this VM's public IP first - HTTP-01 validation needs it to resolve.
SITE_ADDRESS=open-insights.duckdns.org

# Where uploads and the SQLite database live on the host. Must be a real local
# filesystem: SQLite runs in WAL mode.
#
# The container runs as uid 1000, so this must be writable by it - create it
# before the first `up` or the server dies on boot unable to make its upload
# directory:
#   sudo mkdir -p /opt/open-insights/data && sudo chown -R 1000:1000 /opt/open-insights/data
DATA_DIR=/opt/open-insights/data

# The origin the browser client is served from, comma-separated for more than
# one. This is your Cloudflare Pages URL.
ALLOWED_ORIGINS=https://open-insights.pages.dev

# The two keys. Generate both with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#
# PUBLIC_API_KEY ships inside the client bundle, so it is readable by anyone who
# loads the page. That is understood and intended - it buys friction against
# scripted abuse and a handle to rotate, not confidentiality. Rotate it by
# changing it here and in client/src/app/data-management/server-config.service.ts.
PUBLIC_API_KEY=
# PRIVATE_API_KEY is exempt from every limit. Keep it out of the client.
PRIVATE_API_KEY=
